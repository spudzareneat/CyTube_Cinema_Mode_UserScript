{
  "scriptId": "cytube.pc",
  "displayName": "CyTube Fullscreen Video with Overlay Chat",
  "baseVersion": "4.10.4",
  "headerTemplate": "src/pc/header.template.js",
  "match": [
    "https://cytu.be/r/420Grindhouse",
    "https://cytu.be/r/testing"
  ],
  "runAt": "document-start",
  "modules": [
    {
      "id": "core",
      "name": "Core (required)",
      "category": "Core",
      "locked": true,
      "defaultOn": true,
      "files": [
        "src/pc/core/02-keys-and-helpers.js",
        "src/pc/core/10-registry.js",
        "src/pc/core/01-movie-identity.js",
        "src/pc/core/17-imdb-lookup.js",
        "src/pc/core/03-gif-bridge.js",
        "src/pc/core/04-channel-script-autoapprove.js",
        "src/pc/core/05-monitor-orientation.js",
        "src/pc/core/11-chat-input-and-emotes.js",
        "src/pc/core/06-chat-textarea-install.js",
        "src/pc/core/07-floating-buttons.js",
        "src/pc/core/08-desync.js",
        "src/pc/core/09-user-color-system.js",
        "src/pc/core/12-playback-sync-and-seek.js",
        "src/pc/core/13-user-decorations.js",
        "src/pc/core/14-chat-panel-chrome.js",
        "src/pc/core/15-settings-modal-shell.js",
        "src/pc/core/16-boot.js"
      ],
      "cssFiles": [
        "src/pc/core/css/00-layout-core.css"
      ],
      "dependsOn": [],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "caching.graphql.imdb.com"
      ]
    },
    {
      "id": "movie-title-links",
      "name": "Movie Title Links",
      "category": "Movie Info",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/movie-title-links/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/movie-title-links/style.css"
      ],
      "dependsOn": ["core"],
      "connects": [
        "en.wikipedia.org"
      ]
    },
    {
      "id": "imdb-trivia",
      "name": "IMDb Trivia",
      "category": "Movie Info",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/imdb-trivia/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/imdb-trivia/style.css"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "tonights-lineup",
      "name": "Tonight's Lineup",
      "category": "Movie Info",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/tonights-lineup/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/tonights-lineup/style.css"
      ],
      "dependsOn": ["core", "movie-title-links"],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "www.reddit.com"
      ]
    },
    {
      "id": "tmdb",
      "name": "TMDB Supplemental Images",
      "category": "Movie Info",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/tmdb/index.js"
      ],
      "dependsOn": ["core"],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "api.themoviedb.org",
        "raw.githubusercontent.com"
      ]
    },
    {
      "id": "grammar-check",
      "name": "Grammar Check",
      "category": "Chat",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/grammar-check/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/grammar-check/style.css"
      ],
      "dependsOn": ["core"],
      "grants": [],
      "connects": [
        "api.languagetool.org"
      ]
    },
    {
      "id": "chatimages",
      "name": "Chat Images",
      "category": "Chat & Media",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/chatimages/index.js"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "movie-lead-time",
      "name": "Movie Lead Time",
      "category": "Playback",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/movie-lead-time/index.js"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "subtitles",
      "name": "Subtitle Sync",
      "category": "Playback",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/subtitles/index.js"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "gifmaker",
      "name": "GIF Maker",
      "category": "Chat & Media",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/gifmaker/index.js"
      ],
      "dependsOn": ["core"],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "cdnjs.cloudflare.com",
        "cdn.jsdelivr.net",
        "api.imgbb.com"
      ],
      "requires": [
        "https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.js"
      ]
    }
  ]
}
