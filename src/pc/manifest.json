{
  "scriptId": "cytube.pc",
  "displayName": "CyTube Fullscreen Video with Overlay Chat",
  "baseVersion": "4.10.4",
  "headerTemplate": "src/pc/header.template.js",
  "match": [
    "https://cytu.be/r/420Grindhouse",
    "https://cytu.be/r/testing"
  ],
  "runAt": "document-start",
  "modules": [
    {
      "id": "core",
      "name": "Core (required)",
      "category": "Core",
      "locked": true,
      "defaultOn": true,
      "files": [
        "src/pc/core/02-keys-and-helpers.js",
        "src/pc/core/10-registry.js",
        "src/pc/core/01-movie-identity.js",
        "src/pc/core/03-gif-bridge.js",
        "src/pc/core/04-channel-script-autoapprove.js",
        "src/pc/core/05-monitor-orientation.js",
        "src/pc/core/11-chat-input-and-emotes.js",
        "src/pc/core/06-chat-textarea-install.js",
        "src/pc/core/07-floating-buttons.js",
        "src/pc/core/08-desync.js",
        "src/pc/core/09-user-color-system.js",
        "src/pc/core/12-playback-sync-and-seek.js",
        "src/pc/core/13-user-decorations.js",
        "src/pc/core/14-chat-panel-chrome.js",
        "src/pc/core/15-settings-modal-shell.js",
        "src/pc/core/16-boot.js"
      ],
      "cssFiles": [
        "src/pc/core/css/00-layout-core.css"
      ],
      "dependsOn": [],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "api.themoviedb.org",
        "api.imgbb.com"
      ]
    },
    {
      "id": "movie-title-links",
      "name": "Movie Title Links",
      "category": "Movie Info",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/movie-title-links/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/movie-title-links/style.css"
      ],
      "dependsOn": ["core"],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "api.themoviedb.org",
        "en.wikipedia.org",
        "raw.githubusercontent.com"
      ]
    },
    {
      "id": "imdb-trivia",
      "name": "IMDb Trivia",
      "category": "Movie Info",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/imdb-trivia/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/imdb-trivia/style.css"
      ],
      "dependsOn": ["core", "movie-title-links"],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "caching.graphql.imdb.com"
      ]
    },
    {
      "id": "tonights-lineup",
      "name": "Tonight's Lineup",
      "category": "Movie Info",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/tonights-lineup/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/tonights-lineup/style.css"
      ],
      "dependsOn": ["core", "movie-title-links"],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "www.reddit.com"
      ]
    },
    {
      "id": "grammar-check",
      "name": "Grammar Check",
      "category": "Chat",
      "locked": false,
      "defaultOn": true,
      "phase": 1,
      "files": [
        "src/pc/modules/grammar-check/index.js"
      ],
      "cssFiles": [
        "src/pc/modules/grammar-check/style.css"
      ],
      "dependsOn": ["core"],
      "grants": [],
      "connects": [
        "api.languagetool.org"
      ]
    },
    {
      "id": "chatimages",
      "name": "Chat Images",
      "category": "Chat",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/chatimages/index.js"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "movie-lead-time",
      "name": "Movie Lead Time",
      "category": "Misc",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/movie-lead-time/index.js"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "rename-title",
      "name": "Grindhouse Title Renamer",
      "category": "Misc",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/rename-title/index.js"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "subtitles",
      "name": "Subtitle Sync",
      "category": "Misc",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/subtitles/index.js"
      ],
      "dependsOn": ["core"]
    },
    {
      "id": "gifmaker",
      "name": "GIF Maker",
      "category": "Misc",
      "locked": false,
      "defaultOn": true,
      "files": [
        "src/pc/modules/gifmaker/index.js"
      ],
      "dependsOn": ["core"],
      "grants": [
        "GM_xmlhttpRequest"
      ],
      "connects": [
        "cdnjs.cloudflare.com",
        "cdn.jsdelivr.net",
        "api.imgbb.com"
      ],
      "requires": [
        "https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.js"
      ]
    }
  ],
  "companions": [
    {
      "id": "gifmaker",
      "name": "CyTube GIF Maker",
      "description": "Standalone scene-to-GIF capture with meme captions and ImgBB upload — a record button (in the video's own control bar, or floating if cytube.pc.custom.user.js is also installed), disabled during YouTube playback. Integrates with cytube.pc.custom.user.js when installed.",
      "file": "cytube.gifmaker.user.js"
    },
    {
      "id": "subtitles",
      "name": "CyTube Subtitle Sync",
      "description": "Load a local .srt/.vtt subtitle file and sync it to native <video> playback, with a persistent font-size setting, a draggable/steppable position pad for on-screen caption placement, and a short-lived per-movie cache that survives a page refresh. Not available for YouTube playback. Integrates with cytube.pc.custom.user.js when installed, including an OpenSubtitles search link for the currently playing movie.",
      "file": "cytube.subtitles.user.js"
    },
    {
      "id": "chatimages",
      "name": "CyTube Chat Images",
      "description": "Standalone auto-embed for direct image links in chat, with hover filenames and a per-image ban/unban. Works alone, or defers to cytube.pc.custom.user.js's Settings Modal toggle when that script is also installed.",
      "file": "cytube.chatimages.user.js"
    },
    {
      "id": "rename-title",
      "name": "CyTube Grindhouse Title Renamer",
      "description": "Renames the page title on the 420Grindhouse room to \"The Grindhouse\".",
      "file": "cytube.rename-title.user.js"
    }
  ]
}
